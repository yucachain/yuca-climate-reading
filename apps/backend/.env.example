# YucaVault Backend Server Environment Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection String
# Adjust user, password, host, port, and database name as needed
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yucavault?schema=public"

# Telemetry Polling Interval in milliseconds (default: 3000ms = 3s)
POLL_INTERVAL_MS=3000

# CORS Allowed Frontend Origin
FRONTEND_URL="http://localhost:3000"
