{
  "name": "yucavault-climate-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev --workspace=@yucavault/backend\" \"npm run dev --workspace=@yucavault/frontend\"",
    "dev:backend": "npm run dev --workspace=@yucavault/backend",
    "dev:frontend": "npm run dev --workspace=@yucavault/frontend",
    "build": "npm run build --workspaces",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run start --workspace=@yucavault/backend\" \"npm run start --workspace=@yucavault/frontend\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
